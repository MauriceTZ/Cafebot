# Opciones de la misión para el servicio cafebot-mision. instalar_servicio.sh copia este archivo a mision.env (que
# NO se sube al repositorio): cambiar mision.env entre rondas y después  sudo systemctl restart cafebot-mision
#   --nivel 1|2|3        1 = granos en el robot | 2 = + entregar maduros | 3 = + sobremaduros y más árboles
#   --cajas colores|cercana|guardar     si las dos cajas son del mismo color (docs/mision.md)
#   --brazo / --vision camara           el brazo y la cámara reales (sin ellos: solo navega)
#   (5 nov: canastas roja y azul confirmadas: colores. guardar / cercana solo si no se distinguen)
# Rama navegacion-ir: la misión SIN LiDAR (tools.mision_ir: IR + odometría + IMU + cámara, granos en el robot)
MISION_TOOL=tools.mision_ir
MISION_ARGS="--brazo --imu"
# La de siempre (con LiDAR):
# MISION_TOOL=tools.mision
# MISION_ARGS="--brazo --vision camara --nivel 2 --cajas colores"
