# Nombres fijos para los 3 dispositivos USB-serial del robot.
# Sin esto, Mega / LD06 / U2D2 se reparten ttyUSB0/ttyUSB1/... según el orden en que se conectan en cada arranque
# (hoy el brazo y el LiDAR usan los dos /dev/ttyUSB0 en el código antiguo).
#
# Instalar:  sudo cp 99-cafebot.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Verificar los IDs de TU hardware antes (pueden variar con clones):
#   udevadm info -a -n /dev/ttyUSB1 | grep -E "idVendor|idProduct|serial" | head
#
# Arduino Mega original (ATmega16U2) o clon con CH340 -> /dev/cafebot-mega
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0042", SYMLINK+="cafebot-mega"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", SYMLINK+="cafebot-mega"
# LD06 con su adaptador USB (CP2102) -> /dev/cafebot-lidar          [CONFIRMAR IDs]
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="cafebot-lidar"
# U2D2 de Dynamixel (chip FTDI: 6014 = FT232H, algunos 6001/6010) -> /dev/cafebot-u2d2; latencia 1 ms para el bus.
# Se reconoce solo por el fabricante (0403): es el único aparato FTDI del robot.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", SYMLINK+="cafebot-u2d2", RUN+="/bin/sh -c 'echo 1 > /sys/bus/usb-serial/devices/%k/latency_timer'"
