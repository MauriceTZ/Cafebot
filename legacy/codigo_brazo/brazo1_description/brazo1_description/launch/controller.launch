<launch>

<rosparam file="$(find brazo1_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="brazo1" args="Revolute 4_position_controller Revolute 5_position_controller Revolute 16_position_controller Revolute 18_position_controller Revolute 38_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/brazo1/joint_states"/>
</node>

</launch>